# Public domain. Set the real HTTPS deployment origin for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk Dashboard > API Keys. Never commit .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs, e.g. user_123. Missing/empty means nobody may dial.
CLERK_ALLOWED_USER_IDS=
# Explicit owner/admin Clerk IDs for reviewing number setup (must also be approved operators).
VEILCALL_ADMIN_USER_IDS=

# Twilio Voice configuration (server-only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
# Clerk ID that owns the configured primary/additional caller IDs. Set before approving a second operator.
# If omitted, only an installation with exactly one approved operator inherits its configured numbers.
TWILIO_CALLER_ID_OWNER_USER_ID=
# Optional additional approved caller IDs. Each must be Twilio-owned or verified in this account.
# Keep the primary number above; it remains the default. Include it below only to customize its label.
# JSON array, e.g. [{"label":"UK sales","number":"+442079460123"}]
TWILIO_CALLER_IDS=[]
# Create with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TWILIO_CALL_SIGNING_SECRET=
# Must be identical to the TwiML App Voice Request URL (POST), public HTTPS.
TWILIO_WEBHOOK_URL=
# Explicit kill switch. Set true only when Twilio is configured and account budgets are set.
TWILIO_CALLING_ENABLED=false
# Optional test restriction: comma-separated permitted US/Canadian (+1), UK (+44), or Australian (+61) recipients.
TWILIO_ALLOWED_DESTINATIONS=

# Private call review storage. Use pooled Postgres for the app, direct for migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=
# Recording is always off per call until the operator confirms participant consent.
VOICE_RECORDING_ENABLED=false
# Audio retention for new recordings, between 1 and 365 days.
RECORDING_RETENTION_DAYS=30
# Generate a random secret for the daily retention job. Vercel sends Bearer <CRON_SECRET>.
CRON_SECRET=

# Optional email callback reminders. Use a verified Resend sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VeilCall <reminders@mail.veilcode.studio>
# Production only. Operators must also enable their own email preference.
CALLBACK_EMAIL_ENABLED=false

# Stripe server-only restricted (preferred) or secret API keys.
# Vercel Production selects PROD; local, Preview, and custom environments select TEST.
# Scope PROD to Production only; TEST to Preview and Development only.
# Never prefix either variable with NEXT_PUBLIC_. Live commerce stays closed by default.
STRIPE_PROD_API_KEY=
STRIPE_TEST_API_KEY=

# Owner-only billing sandbox. Enable only in local/isolated billing-pilot Preview.
# Test objects and credit stay isolated even when the approved offer uses the same amounts.
VEILCALL_BILLING_TEST_ENABLED=false
STRIPE_TEST_MONTHLY_PRICE_ID=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PORTAL_CONFIGURATION_ID=

# Production release preparation. Never enable this during Preview or sandbox QA.
# Also requires an owner-activated, complete offer in Billing > Paid pilot setup.
# Numeric prices, policies and caller/route rates are versioned in Postgres.
VEILCALL_LIVE_BILLING_ENABLED=false
STRIPE_PROD_WEBHOOK_SECRET=
STRIPE_PROD_PORTAL_CONFIGURATION_ID=
